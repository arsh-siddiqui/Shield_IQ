NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shieldiq

# Use a long, random string in real deployments — this is only a placeholder.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Must match the URL the frontend is served from — required for the auth
# cookie (SameSite/credentials) to work across origins.
CLIENT_URL=http://localhost:5173

# Used only by `npm run seed` to create the first admin account.
ADMIN_SEED_EMAIL=admin@shieldiq.app
ADMIN_SEED_PASSWORD=ChangeMe123!

# ===========================================================================
# THREAT INTELLIGENCE
# ===========================================================================

# PhishDestroy Threat API
PHISHDESTROY_API_URL=https://api.destroy.tools
PHISHDESTROY_TIMEOUT_MS=4000

# How long to cache threat intelligence results (hours)
THREAT_INTEL_CACHE_TTL=6

# ===========================================================================
# ML INFERENCE SERVICE (Python/FastAPI — run separately)
# ===========================================================================

# Base URL of the Python ML service
ML_SERVICE_URL=http://localhost:8001

# Timeout for ML inference calls (milliseconds)
ML_SERVICE_TIMEOUT_MS=3000

# ===========================================================================
# GROQ AI
# ===========================================================================

# Groq API key — obtain from: https://console.groq.com
GROQ_API_KEY=

# Groq model — see: https://console.groq.com/docs/models
# Recommended: llama-3.1-8b-instant (fast) or mixtral-8x7b-32768 (more capable)
GROQ_MODEL=llama-3.1-8b-instant

# Timeout for Groq API calls (milliseconds)
GROQ_TIMEOUT_MS=7000
